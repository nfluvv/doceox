generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         String  @id @default(cuid())
  telegramId String  @unique
  name       String?
  username   String? @unique
  image      String?
  role       Role    @default(USER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  studySessions StudySession[]

  timezone  String   @default("UTC")

  isPremium Boolean  @default(false)

  notifyStreak   Boolean   @default(true) 
  lastNotifiedAt DateTime?
  locale         String    @default("ru")

  @@index([name])
  @@map("users")
  orders Order[]
  decks Deck[]
  cardProgresses CardProgress[]
  savedDecks SavedDeck[]
}

model RoleChangeLog {
  id             String   @id @default(cuid())
  targetId       String
  targetUsername String?
  changedById    String
  fromRole       Role
  toRole         Role
  createdAt      DateTime @default(now())

  @@map("role_change_logs")
}

model RateLimitAttempt {
  id         String   @id @default(cuid())
  identifier String
  createdAt  DateTime @default(now())

  @@index([identifier, createdAt])
  @@map("rate_limit_attempts")
}

model Deck {
  id          String   @id @default(cuid())
  title       String
  description String?
  status      DeckStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  cards       Card[]
  studySessions StudySession[]

  @@index([userId, status])
  @@map("decks")
  savedDecks SavedDeck[]
}

model Card {
  id         String   @id @default(cuid())
  term       String
  definition String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  deckId     String
  deck       Deck     @relation(fields: [deckId], references: [id], onDelete: Cascade)

  @@map("cards")
  cardProgresses CardProgress[]
}

model StudySession {
  id          String   @id @default(cuid())
  userId      String
  deckId      String
  completedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  deck Deck @relation(fields: [deckId], references: [id], onDelete: Cascade)

  @@index([userId, completedAt])
  @@index([userId, deckId, completedAt])
  @@map("study_sessions")
}

model CardProgress {
  id            String   @id @default(cuid())
  userId        String
  cardId        String

  easeFactor    Float    @default(2.5)
  interval      Int      @default(0)    // days
  repetitions   Int      @default(0)
  dueDate       DateTime @default(now())

  lastReviewedAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([userId, cardId])
  @@index([userId, dueDate])
  @@map("card_progress")
}

model SavedDeck {
  id        String   @id @default(cuid())
  userId    String
  deckId    String
  savedAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  deck Deck @relation(fields: [deckId], references: [id], onDelete: Cascade)

  @@unique([userId, deckId])
  @@index([userId, savedAt])
  @@map("saved_decks")
}


enum OrderStatus {
  PENDING
  PAID
  REFUNDED
}

model Order {
  id        String      @id @default(cuid())
  userId    String
  productId String
  stars     Int
  status    OrderStatus @default(PENDING)
  chargeId  String?     @unique
  paidAt    DateTime?
  createdAt DateTime    @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@map("orders")
}


enum Role {
  USER
  ADMIN
}


enum DeckStatus {
  DRAFT
  PRIVATE
  PUBLIC
}