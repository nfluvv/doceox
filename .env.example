# App environment (change to "production" in prod)
NODE_ENV="development"

# Database connection string (e.g., postgresql://user:password@localhost:5432/db)
DATABASE_URL=""

# NextAuth production URL (must match your production domain)
NEXTAUTH_URL="http://localhost:3000"

# Main application URL for absolute links
APP_URL="http://localhost:3000"

# Random secure string for encrypting sessions (generate via: openssl rand -base64 32)
AUTH_SECRET="secret"

# Secret token to verify that incoming webhook requests actually come from Telegram
TELEGRAM_WEBHOOK_SECRET="secret"

# Bot token from @BotFather (e.g., 123456:ABC-DEF...)
TELEGRAM_BOT_TOKEN=""

# Secret key to authorize automated cron job requests to your API routes
CRON_SECRET="secret"

# Public Telegram bot username (without @, visible on the client side)
NEXT_PUBLIC_BOT_USERNAME="hello_bot"

# Public Telegram Mini App short name (visible on the client side)
NEXT_PUBLIC_MINI_APP_NAME="app"
